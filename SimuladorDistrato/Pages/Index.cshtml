@page
@model SimuladorDistrato.Pages.IndexModel

@{
    ViewData["Title"] = "Simulador de Distrato";
}

<div class="container mt-5">

    <h1 class="mb-4">
        Simulador de Distrato de Locação
    </h1>

    <p class="mb-4">
        Informe os dados abaixo para obter uma estimativa dos valores
        envolvidos no encerramento antecipado do contrato de locação.
    </p>

    <form method="post">

        <div class="row">

            <div class="col-md-6 mb-3">
                <label class="form-label">
                    Valor total da multa contratual prevista em contrato
                </label>

                <input type="text"
                       class="form-control campo-moeda"
                       data-hidden="Input_MultaContratual"
                       inputmode="numeric"
                       autocomplete="off" />

                <input asp-for="Input.MultaContratual"
                       type="hidden"
                       id="Input_MultaContratual" />
                <input type="hidden"
                       name="__Invariant"
                       value="Input.MultaContratual" />
            </div>

        </div>

        <div class="row">

            <div class="col-md-4 mb-3">
                <label asp-for="Input.DataInicioContrato"
                       class="form-label">
                    Data de início do contrato
                </label>

                <input asp-for="Input.DataInicioContrato"
                       class="form-control"
                       type="date" />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Input.DataFimContrato"
                       class="form-label">
                    Data de término do contrato
                </label>

                <input asp-for="Input.DataFimContrato"
                       class="form-control"
                       type="date" />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Input.DataDesocupacao"
                       class="form-label">
                    Data da desocupação
                </label>

                <input asp-for="Input.DataDesocupacao"
                       class="form-control"
                       type="date" />
            </div>

        </div>

        <div class="row">

            <div class="col-md-4 mb-3">
                <label class="form-label">
                    Valor da caução
                </label>

                <input type="text"
                       class="form-control campo-moeda"
                       data-hidden="Input_ValorCaucao"
                       inputmode="numeric"
                       autocomplete="off" />

                <input asp-for="Input.ValorCaucao"
                       type="hidden"
                       id="Input_ValorCaucao" />
                <input type="hidden"
                       name="__Invariant"
                       value="Input.ValorCaucao" />
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">
                    Outros débitos
                </label>

                <input type="text"
                       class="form-control campo-moeda"
                       data-hidden="Input_OutrosDebitos"
                       inputmode="numeric"
                       autocomplete="off" />

                <input asp-for="Input.OutrosDebitos"
                       type="hidden"
                       id="Input_OutrosDebitos" />
                <input type="hidden"
                       name="__Invariant"
                       value="Input.OutrosDebitos" />

            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">
                    Outros créditos
                </label>

                <input type="text"
                       class="form-control campo-moeda"
                       data-hidden="Input_OutrosCreditos"
                       inputmode="numeric"
                       autocomplete="off" />

                <input asp-for="Input.OutrosCreditos"
                       type="hidden"
                       id="Input_OutrosCreditos" />
                <input type="hidden"
                       name="__Invariant"
                       value="Input.OutrosCreditos" />
            </div>
        </div>

        <button type="submit"
                class="btn btn-primary mt-3">
            Calcular
        </button>

    </form>


    @if (!string.IsNullOrEmpty(Model.MensagemErro))
    {
        <div class="alert alert-danger mt-4">
            @Model.MensagemErro
        </div>
    }


    @if (Model.Resultado != null)
    {
        <div class="card mt-4 shadow-sm">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-receipt"></i> DETALHAMENTO DO DISTRATO</h5>
                <span class="badge bg-secondary">Simulação sem Retenção de Dados</span>
            </div>

            <div class="card-body p-4">

                <div class="alert @(Model.Resultado.SaldoFinal > 0 ? "alert-danger" : Model.Resultado.SaldoFinal < 0 ? "alert-success" : "alert-secondary") text-center p-3 mb-4 shadow-sm" role="alert">
                    <span class="text-uppercase fw-bold d-block mb-1" style="letter-spacing: 1px;">Resultado Final da Apuração</span>
                    <h4 class="fw-bold mb-0">@Model.Resultado.MensagemResponsabilidadePagamento</h4>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold text-muted border-bottom pb-2">1. MULTA</h6>
                    <div class="p-3 bg-light rounded border">
                        <p class="mb-0 font-monospace fw-bold fs-6">@Model.Resultado.FormulaMultaDetalhada</p>
                        <small class="text-muted">
                            Fórmula Aplicada*: Multa Proporcional = (Multa Total Contratual / Duração Total do Contrato em Dias) x Dias Restantes
                        </small>
                    </div>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold text-muted border-bottom pb-2">2. DEMONSTRATIVO</h6>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle border">
                            <thead class="table-dark">
                                <tr>
                                    <th>#</th>
                                    <th>Descrição</th>
                                    <th class="text-center">Tipo</th>
                                    <th class="text-end">Valor (R$)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Resultado.ItensExtrato.Count; i++)
                                {
                                    var item = Model.Resultado.ItensExtrato[i];
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td class="fw-medium">@item.Descricao</td>
                                        <td class="text-center">
                                            @if (item.EhDebito)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">DÉBITO</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success px-2 py-1">CRÉDITO</span>
                                            }
                                        </td>
                                        <td class="text-end fw-bold font-monospace @(item.EhDebito ? "text-danger" : "text-success")">
                                            @item.Valor.ToString("C2")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="3" class="text-end fw-bold fs-5">SALDO FINAL APURADO:</td>
                                    <td class="text-end fw-bold fs-5 font-monospace @(Model.Resultado.SaldoFinal > 0 ? "text-danger" : Model.Resultado.SaldoFinal < 0 ? "text-success" : "text-dark")">
                                        @Model.Resultado.SaldoFinal.ToString("C2")
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <div class="text-end">
                    <small class="text-muted">
                        <em>* Os débitos aumentam a obrigação do locatário. Os créditos representam os valores a serem deduzidos.</em>
                    </small>
                </div>

            </div>
        </div>
    }

</div>